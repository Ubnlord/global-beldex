# Public browser configuration. These values are supplied by GitHub Actions secrets/variables
# and are intentionally not committed with real values.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only values. NEVER expose these with a VITE_ prefix.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional server/runtime secrets
DATABASE_URL=YOUR_DATABASE_URL
GROK_CONNECTOR_ACCESS_TOKEN=YOUR_CONNECTOR_TOKEN
